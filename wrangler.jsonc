{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "langual-academy-backend",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "FRONTEND_URL": "http://localhost:3000",
  },
}
